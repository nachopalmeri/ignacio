{
 "source": {
  "repo": "github.com/nachopalmeri/agents-system (público)",
  "router": "orchestrator/router.ps1",
  "rules": "config/routing-rules.json @ 3f21f5e^ (última versión con patrones)",
  "evals": "evals/runtime-cases.json @ 5cfe298"
 },
 "lanes": {
  "SIMPLE": "Fallback, explicación o cambio chico; un agente, sin reviewer/council automáticos.",
  "SPECIALIZED": "El dominio cambia materialmente la ejecución; un primary especialista.",
  "PARALLEL": "El usuario pide paralelismo/council o hay dos trabajos independientes con ownership separado.",
  "HIGH_RISK": "Credenciales, pagos, mensajes externos, destrucción, producción o release consecuencial; aprobación explícita y validación proporcional."
 },
 "rules": {
  "schemaVersion": 2,
  "laneBudgets": {
   "SIMPLE": {
    "maxIterations": 3,
    "maxReplans": 1,
    "maxAgents": 1
   },
   "SPECIALIZED": {
    "maxIterations": 6,
    "maxReplans": 2,
    "maxAgents": 1
   },
   "PARALLEL": {
    "maxIterations": 8,
    "maxReplans": 2,
    "maxAgents": 4
   },
   "HIGH_RISK": {
    "maxIterations": 5,
    "maxReplans": 1,
    "maxAgents": 2
   }
  },
  "capabilityByAgent": {
   "agente-principal": "general-implementation",
   "agente-researcher": "current-research",
   "agente-design": "frontend-design",
   "agente-growth-seo-geo": "seo-geo-aeo",
   "agente-academic-tutor": "academic-tutoring",
   "agente-obsidian-brain": "obsidian-knowledge",
   "agente-security-auditor": "security-review",
   "agente-release-manager": "release-publication"
  },
  "highRisk": [
   {
    "reason": "risk-release",
    "primary": "agente-release-manager",
    "patterns": [
     "\\bpublish(?: the)? production release\\b",
     "\\bdeploy(?: it)? to production\\b",
     "\\brelease to production\\b",
     "\\bpublicar(?: el| la)? release\\b"
    ]
   },
   {
    "reason": "risk-credentials",
    "primary": "agente-security-auditor",
    "patterns": [
     "\\b(?:rotate|update|replace|expose|share)\\b.{0,40}\\b(?:secret|token|credential|api key)\\b",
     "\\b(?:rota|actualiza|reemplaza|expone|comparti)\\w*\\b.{0,40}\\b(?:secreto|token|credencial|api key)\\b"
    ]
   },
   {
    "reason": "risk-production-write",
    "primary": "agente-security-auditor",
    "patterns": [
     "\\b(?:write|migrate|delete|deploy)\\w*\\b.{0,60}\\bproduction\\b",
     "\\b(?:escrib|migr|borr|despleg)\\w*\\b.{0,60}\\b(?:produccion|productiva)\\b"
    ]
   },
   {
    "reason": "risk-payment",
    "primary": "agente-security-auditor",
    "patterns": [
     "\\b(?:make|execute|send|charge)\\w*\\b.{0,40}\\b(?:payment|card|purchase)\\b",
     "\\b(?:realiza|ejecuta|envia|cobra|compra)\\w*\\b.{0,40}\\b(?:pago|tarjeta|suscripcion)\\b"
    ]
   },
   {
    "reason": "risk-external-message",
    "primary": "agente-security-auditor",
    "patterns": [
     "\\b(?:send|post)\\w*\\b.{0,40}\\b(?:external dm|customer message|email)\\b",
     "\\b(?:envia|manda|publica)\\w*\\b.{0,40}\\b(?:dm|mensaje|email)\\b"
    ]
   },
   {
    "reason": "risk-destructive",
    "primary": "agente-security-auditor",
    "patterns": [
     "\\b(?:delete|remove|drop|destroy)\\b.{0,50}\\b(?:all|recursively|customer data|database)\\b",
     "\\b(?:borra|elimina|destrui)\\w*\\b.{0,50}\\b(?:todo|recursiv|datos|base de datos)\\b"
    ]
   }
  ],
  "parallel": {
   "patterns": [
    "\\bin parallel\\b",
    "\\bparallel tracks?\\b",
    "\\bindependent agents?\\b",
    "\\bmultiple independent advisers?\\b",
    "\\ben paralelo\\b",
    "\\bagentes independientes\\b",
    "\\basesores paralelos\\b"
   ],
   "councilPatterns": [
    "\\bllm council\\b",
    "\\bthe council\\b",
    "\\bactiva(?: el)? council\\b",
    "\\busa(?: el)? council\\b"
   ]
  },
  "specialists": [
   {
    "priority": 10,
    "reason": "specialist-academic",
    "primary": "agente-academic-tutor",
    "component": ".agents/workflows/academic_tutor.md",
    "patterns": [
     "\\bparcial(?:es)?\\b",
     "\\bexam prep\\b",
     "\\bstudy session\\b",
     "\\bpracticar\\b.{0,30}\\b(?:economia|programacion|materia)\\b",
     "\\btomame(?:\\sun)?\\b.{0,30}\\b(?:parcial|examen|quiz)\\b",
     "\\brepasar\\b.{0,30}\\b(?:para el|materia|tema)\\b"
    ],
    "negativeTriggers": [
     "\\bvista parcial\\b",
     "\\bactualizacion parcial\\b",
